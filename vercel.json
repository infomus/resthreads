      "permanent": true
    },
    {
      "source": "/resident-chat-vs-ai-leasing-chatbot",
      "destination": "/resident-chat-vs-ai-leasing-chatbot/",
      "permanent": true
    },
    {
      "source": "/student-housing-resident-ambassadors",
      "destination": "/student-housing-resident-ambassadors/",
      "permanent": true
    },
    {
      "source": "/multifamily-leasing-conversion",
      "destination": "/multifamily-leasing-conversion/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/demo",
