{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.resthreads.com"
        }
      ],
      "destination": "https://resthreads.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/apartment-resident-chat-widget",
      "destination": "/apartment-resident-chat-widget/",
      "permanent": true
    },
    {
      "source": "/resident-ambassador-program",
